#!/usr/bin/env python3
"""agent: run Codex or pi headless for Claude Code, and run pre-push reviews.

  agent codex  [-m MODEL] [-e EFFORT] [-C DIR] [--write] [--resume ID] PROMPT|-
  agent pi     [-m PROVIDER/ID] [-e THINKING] [-C DIR] [--write] [--resume ID] PROMPT|-
  agent review [-m MODEL] [-e EFFORT] [-C DIR] [--base REF | --uncommitted] [PROMPT]
  agent stamp  [-C DIR] --by claude|craig --note TEXT
      claude: Claude reviewed HEAD (code written only by Codex/pi, or a targeted fix after the first push)
      craig:  Craig overruled open P0/P1 findings on HEAD (only after he says so in chat)

Read-only unless --write. Prints only the final answer on stdout; one summary line
on stderr. Every run is saved under ~/.agent-runs/<time>-<pid>-<agent>-<model>/.
A review stamps HEAD only when it finishes with no [P0]/[P1] finding. Every review also applies the
ponytail-review lens (over-engineering as [P3], which never blocks). Diffs of COMPLEX_LOC+ lines or
COMPLEX_FILES+ files also get COMPLEX_REVIEW_MODEL in parallel; its P0/P1 block too, its failure does not.
"""
import argparse, datetime, json, os, re, subprocess, sys, threading, time, urllib.error, urllib.request
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

CODEX_PATHS = ("/Applications/ChatGPT.app/Contents/Resources/codex-cli/bin/codex",  # ChatGPT app since 2026-09-30
               "/Applications/ChatGPT.app/Contents/Resources/codex")  # older app builds
CODEX = os.environ.get("CODEX_BIN") or next((p for p in CODEX_PATHS if os.path.exists(p)), "codex")
RUNS = Path(os.environ.get("AGENT_RUNS", "~/.agent-runs")).expanduser()
PI = os.environ.get("PI_BIN", "pi")
CODEX_MODEL, REVIEW_MODEL, REVIEW_EFFORT = "gpt-6.1-sol", "gpt-6.1-sol", "high"
# Large diffs also get Kimi K3 (best recall on the 2026-10-02 bakeoff). Fails open: Sol alone still stamps.
COMPLEX_REVIEW_MODEL, COMPLEX_LOC, COMPLEX_FILES, COMPLEX_TIMEOUT = "openrouter/moonshotai/kimi-k3", 800, 15, 900
DIFF_ARG_BYTES = 600_000  # second reviewer's diff, inlined in pi's argv
PI_READ_TOOLS = "read,grep,find,ls,evaluate"  # no mcp/mcpScript: they reach MCP tools that write
BILL_DEADLINE = 30  # seconds for OpenRouter cost lookups after a pi run; past it, pi's cost stands (labelled)
RULES = """You are a delegated worker. Claude Code owns this task and reviews your work.
- Work only inside {cwd}.
- {mode}
- Never run git commit, push, branch, checkout, switch, reset, rebase, stash, merge, or worktree.
- End with a short report: what you changed (files), what you ran to verify it, what is still open."""
READ_ONLY = "Read-only task: do not create, change, or delete files."
REVIEW_LENS = """Tag every correctness finding [P0] to [P3].
Also apply the ponytail-review skill: flag over-engineering (speculative abstractions, one-implementation
interfaces, factories for one product, reinvented stdlib, unneeded dependencies) as [P3] findings.
Do not read or run Bugbot or any other review skill; you are the reviewer."""
WRITE = "You may change files inside that folder. Leave every change uncommitted."


def git(cwd, *args):
    p = subprocess.run(["git", "-C", cwd, *args], capture_output=True, text=True)
    return p.stdout.strip() if p.returncode == 0 else None


def new_run(agent, model, prompt):
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    d = RUNS / f"{stamp}-{os.getpid()}-{agent}-{(model or 'default').replace('/', '_')}"
    d.mkdir(parents=True)
    (d / "prompt.md").write_text(prompt)
    return d


def execute(cmd, cwd, run_dir, stdout_name="events.jsonl", timeout=None):
    t = time.time()
    with open(run_dir / stdout_name, "w") as out, open(run_dir / "stderr.log", "w") as err:
        try:
            rc = subprocess.run(cmd, cwd=cwd, stdin=subprocess.DEVNULL, stdout=out, stderr=err,
                                timeout=timeout).returncode
        except subprocess.TimeoutExpired:
            rc = 124
    return rc, round(time.time() - t)


def events(run_dir):
    for line in (run_dir / "events.jsonl").read_text().splitlines():
        try:
            yield json.loads(line)
        except ValueError:
            pass


def finish(run_dir, meta, answer):
    (run_dir / "answer.md").write_text(answer)
    (run_dir / "meta.json").write_text(json.dumps(meta, indent=2))
    if answer.strip():
        print(answer.strip())
    else:  # nothing came back: show why
        print(f"[agent] no answer. stderr tail:\n{(run_dir / 'stderr.log').read_text()[-2000:]}")
        for e in meta.get("errors", []):
            print(f"[agent] error: {e}")
    extra = " ".join(f"{k}={meta[k]}" for k in ("session", "cost") if meta.get(k))
    if meta.get("cost") and meta.get("cost_source") == "pi":
        extra += " (pi catalog cost, not OpenRouter's bill)"
    if meta.get("providers"):
        extra += f" via={','.join(meta['providers'])}"
    print(f"[agent] {meta['agent']} {meta['model']} {meta['seconds']}s rc={meta['rc']} {extra} run={run_dir}",
          file=sys.stderr)
    return meta["rc"] or (0 if answer.strip() else 1)


def codex(a, prompt):
    model = a.model or CODEX_MODEL
    sandbox = "workspace-write" if a.write else "read-only"
    opts = ["--json", "--skip-git-repo-check", "-m", model, "-c", f'sandbox_mode="{sandbox}"']
    if a.write:
        opts += ["-c", "sandbox_workspace_write.network_access=true"]
    if a.effort:
        opts += ["-c", f'model_reasoning_effort="{a.effort}"']
    run_dir = new_run("codex", model, prompt)
    opts += ["-o", str(run_dir / "answer.md")]
    cmd = [CODEX, "exec", "resume", *opts, a.resume, prompt] if a.resume else [CODEX, "exec", *opts, prompt]
    rc, secs = execute(cmd, a.cwd, run_dir)
    meta = dict(agent="codex", model=model, effort=a.effort, cwd=a.cwd, write=a.write, rc=rc, seconds=secs,
                session=a.resume, errors=[])
    for e in events(run_dir):
        if e.get("type") == "thread.started":
            meta["session"] = e.get("thread_id")
        elif e.get("type") == "turn.completed":
            meta["usage"] = e.get("usage")
        elif e.get("type") in ("error", "turn.failed"):
            meta["errors"].append(e.get("message") or e.get("error"))
    answer_file = run_dir / "answer.md"
    return finish(run_dir, meta, answer_file.read_text() if answer_file.exists() else "")


def run_pi(a, prompt, timeout=None):
    opts = ["-p", "--mode", "json", "--append-system-prompt", rules(a)]
    if a.model and "/" in a.model:
        provider, mid = a.model.split("/", 1)
        opts += ["--provider", provider, "--model", mid]
    elif a.model:
        opts += ["--model", a.model]
    if a.effort:
        opts += ["--thinking", a.effort]
    if not a.write:
        opts += ["--tools", PI_READ_TOOLS]
    if a.resume:
        opts += ["--session", a.resume]
    run_dir = new_run("pi", a.model, prompt)
    rc, secs = execute([PI, *opts, prompt], a.cwd, run_dir, timeout=timeout)
    meta = dict(agent="pi", model=a.model or "default", effort=a.effort, cwd=a.cwd, write=a.write, rc=rc,
                seconds=secs, session=a.resume, errors=[])
    answer = ""
    for e in events(run_dir):
        if e.get("type") == "session":
            meta["session"] = e.get("id")
        elif e.get("type") == "agent_end":
            turns = [m for m in e.get("messages", []) if m.get("role") == "assistant"]
            last = turns[-1] if turns else {}
            answer = "\n".join(c.get("text", "") for c in last.get("content", []) if c.get("type") == "text")
            meta["model"] = f"{last.get('provider')}/{last.get('model')}" if last.get("model") else meta["model"]
            meta["usage"] = last.get("usage")
            # every turn bills, not just the last
            meta["cost"] = round(sum(((m.get("usage") or {}).get("cost") or {}).get("total", 0) for m in turns), 4) or None
            # pi can exit 0 after a terminal API error; the partial text is not an answer.
            # Assign, not append: only the last agent_end counts, so a retried-then-recovered run passes.
            failed = last.get("errorMessage") or last.get("stopReason") in ("error", "aborted")
            meta["errors"] = [last.get("errorMessage") or f"stopReason={last.get('stopReason')}"] if failed else []
    if meta["model"].startswith("openrouter/"):
        openrouter_bill(run_dir, meta)
    return run_dir, meta, answer


def openrouter_bill(run_dir, meta):
    """Replace pi's cost with OpenRouter's bill. pi prices from its own catalog, and a model missing from it gets
    placeholder rates (2026-11-11: DeepSeek V4.1 Flash 1017 pi $2.69, billed $0.20). Falls back to pi's cost,
    marked cost_source=pi, when any generation can't be looked up."""
    ids = sorted(set(re.findall(r'"responseId":"(gen-[^"]+)"', (run_dir / "events.jsonl").read_text())))
    key = None
    try:  # same precedence as pi: stored credential first, then the environment
        v = json.loads((Path.home() / ".pi/agent/auth.json").read_text()).get("openrouter")
        key = v.get("key") if isinstance(v, dict) else v
    except (OSError, ValueError, AttributeError):
        pass
    key = key or os.environ.get("OPENROUTER_API_KEY")
    meta["pi_cost"], meta["cost_source"] = meta.get("cost"), "pi"
    if not ids or not key:
        return
    deadline = time.monotonic() + BILL_DEADLINE  # best effort: never hold up a review or a stamp for long

    def gen(gid):  # a new generation can 404 for a few seconds
        req = urllib.request.Request(f"https://openrouter.ai/api/v1/generation?id={gid}",
                                     headers={"Authorization": f"Bearer {key}"})
        for wait in (0, 2, 4, 8):
            time.sleep(min(wait, max(0.0, deadline - time.monotonic())))
            left = deadline - time.monotonic()
            if left <= 0:
                return None
            try:
                d = json.load(urllib.request.urlopen(req, timeout=min(10, left)))["data"]
                return d["total_cost"], d["provider_name"]
            except (urllib.error.URLError, OSError, ValueError, KeyError):
                continue
        return None

    with ThreadPoolExecutor(12) as ex:
        got = list(ex.map(gen, ids))
    if all(got):
        meta["cost"], meta["cost_source"] = round(sum(c for c, _ in got), 4), "openrouter"
        meta["providers"] = sorted({p for _, p in got})


def pi(a, prompt):
    return finish(*run_pi(a, prompt))


def default_base(cwd):
    ref = git(cwd, "symbolic-ref", "--quiet", "--short", "refs/remotes/origin/HEAD")
    if ref:
        return ref
    return next((b for b in ("origin/main", "origin/master", "main", "master")
                 if git(cwd, "rev-parse", "--verify", "--quiet", b)), None)


def stamp_path(cwd):
    head, common = git(cwd, "rev-parse", "HEAD"), git(cwd, "rev-parse", "--git-common-dir")
    if not head or not common:
        sys.exit(f"[agent] {cwd} is not a git repo with a commit")
    return head, Path(cwd, common).resolve() / "agent-review" / head


def write_stamp(cwd, **info):
    head, path = stamp_path(cwd)
    path.parent.mkdir(exist_ok=True)
    path.write_text(json.dumps(dict(head=head, time=datetime.datetime.now().isoformat(), **info), indent=2))
    return head


def diff_size(cwd, rng):
    """(files, insertions + deletions) for the diff under review. Naive: tests, migrations, comments all count."""
    stat = git(cwd, "diff", "--shortstat", *rng) or ""
    n = lambda word: int(m[1]) if (m := re.search(rf"(\d+) {word}", stat)) else 0
    return n("file"), n("insertion") + n("deletion")


def review(a, prompt):
    model, effort = a.model or REVIEW_MODEL, a.effort or REVIEW_EFFORT
    head = None if a.uncommitted else stamp_path(a.cwd)[0]
    base = None if a.uncommitted else (a.base or default_base(a.cwd))
    if not a.uncommitted and not base:
        sys.exit("[agent] no base branch found; pass --base")
    # codex review rejects --base/--uncommitted together with a prompt, so the target goes in the prompt
    target = ("Review the uncommitted changes in this repo (staged, unstaged, and untracked)." if a.uncommitted
              else f"Review the changes on the current branch against {base} (git diff {base}...HEAD).")
    task = f"{target}\n{REVIEW_LENS}" + (f"\n\nAdditional instructions:\n{prompt}" if prompt else "")
    rng = ["HEAD"] if a.uncommitted else [f"{base}...HEAD"]  # ponytail: uncommitted size ignores untracked files
    files, loc = diff_size(a.cwd, rng)
    second, result = None, {}
    if loc >= COMPLEX_LOC or files >= COMPLEX_FILES:
        k = argparse.Namespace(**{**vars(a), "model": COMPLEX_REVIEW_MODEL, "effort": "high", "write": False,
                                  "resume": None})
        # pi has no shell tool, so the diff rides in the prompt. ARG_MAX counts bytes, not characters:
        # cap the UTF-8 encoding, well under macOS's 1 MB with room for the other args and env
        diff = (git(a.cwd, 'diff', *rng) or '').encode()[:DIFF_ARG_BYTES].decode(errors="ignore")
        k_task = (f"{task}\n\nOutput only findings, one per line: `[P0-P3] path:line: problem. Fix: one line.` "
                  f"If none, write `No findings`.\n\nThe diff:\n```diff\n{diff}\n```")
        second = threading.Thread(target=lambda: result.update(r=run_pi(k, k_task, timeout=COMPLEX_TIMEOUT)))
        second.start()
    cmd = [CODEX, "review", "-c", f'model="{model}"', "-c", f'model_reasoning_effort="{effort}"', task]
    run_dir = new_run("review", model, task)
    rc, secs = execute(cmd, a.cwd, run_dir, stdout_name="review.md")
    text = (run_dir / "review.md").read_text()
    meta = dict(agent="review", model=model, effort=effort, cwd=a.cwd, base=base, head=head, rc=rc, seconds=secs,
                files=files, loc=loc)
    if second:
        second.join()
        k_dir, k_meta, k_text = result.get("r", (None, {"rc": "crashed"}, ""))
        if k_dir:
            (k_dir / "answer.md").write_text(k_text)
            (k_dir / "meta.json").write_text(json.dumps(k_meta, indent=2))
        meta["second"] = dict(model=COMPLEX_REVIEW_MODEL, rc=k_meta.get("rc"), cost=k_meta.get("cost"), run=str(k_dir))
        if k_meta.get("rc") == 0 and not k_meta.get("errors") and k_text.strip():
            model = f"{model}+{COMPLEX_REVIEW_MODEL}"
            text += f"\n\n## Second reviewer: {COMPLEX_REVIEW_MODEL}\n\n{k_text.strip()}\n"
        else:
            print(f"[agent] warning: second reviewer {COMPLEX_REVIEW_MODEL} failed (rc={k_meta.get('rc')}); "
                  f"stamping on {model} alone", file=sys.stderr)
    # fail closed: any [P0]/[P1] blocks, whatever the finding format (bullet, numbered, bold, JSON).
    # Only an inline-code `[P1]` inside prose is exempt; a quoted tag that leads its line is a finding.
    lead = r"^[^\w\n]*(?:\d+[.)][^\w\n]*)?\[P[01]\]"
    bare = r"(?<!`)\[P[01]\]|\[P[01]\](?!`)"
    blocking = [l for l in text.splitlines() if re.search(lead, l) or re.search(bare, l)]
    if rc == 0 and head:
        if git(a.cwd, "rev-parse", "HEAD") != head:
            meta["errors"] = ["HEAD moved during review; not stamped"]
        elif blocking:
            meta["errors"] = [f"not stamped: {len(blocking)} open P0/P1 finding(s)"]
        else:
            write_stamp(a.cwd, reviewer=model, run=str(run_dir), base=base)
            meta["stamped"] = head
    if meta.get("errors"):
        print(f"[agent] {meta['errors'][0]}", file=sys.stderr)
    return finish(run_dir, meta, text)


def rules(a):
    return RULES.format(cwd=a.cwd, mode=WRITE if a.write else READ_ONLY)


def main():
    ap = argparse.ArgumentParser(prog="agent", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("agent", choices=["codex", "pi", "review", "stamp"])
    ap.add_argument("prompt", nargs="?", help="prompt text, or - to read stdin")
    ap.add_argument("-m", "--model")
    ap.add_argument("-e", "--effort")
    ap.add_argument("-C", "--cwd", default=os.getcwd())
    ap.add_argument("--write", action="store_true")
    ap.add_argument("--resume")
    ap.add_argument("--base")
    ap.add_argument("--uncommitted", action="store_true")
    ap.add_argument("--by")
    ap.add_argument("--note")
    a = ap.parse_args()
    a.cwd = str(Path(a.cwd).expanduser().resolve())
    prompt = sys.stdin.read() if a.prompt == "-" else (a.prompt or "")

    if a.agent == "stamp":
        if a.by not in ("claude", "craig") or not a.note:
            sys.exit("[agent] stamp needs --by claude|craig --note '<what was reviewed or decided>'")
        print(f"[agent] stamped {write_stamp(a.cwd, reviewer=a.by, note=a.note)}")
        return 0
    if a.agent == "review":
        return review(a, prompt)
    if not prompt.strip():
        sys.exit("[agent] empty prompt")
    task = f"{rules(a)}\n\n---\n\n{prompt}" if a.agent == "codex" else prompt
    return codex(a, task) if a.agent == "codex" else pi(a, prompt)


if __name__ == "__main__":
    sys.exit(main())
