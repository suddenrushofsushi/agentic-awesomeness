# @ea — Claude Code, your personal skills. cwd is a dedicated dir so user-level ~/.claude loads and bypass mode applies.
BOT_CMD=/opt/homebrew/bin/claude-agent-acp
BOT_CWD="$HERE/ea"
BOT_ALLOW="claude codex local hermes"
export CLAUDE_CODE_EXECUTABLE=$HOME/.local/bin/claude
export ANTHROPIC_MODEL=claude-fable-5-1
