# @claude — Claude Code for coding. Point BOT_CWD at a repo; that repo needs .claude/settings.local.json with bypassPermissions (see README).
BOT_CMD=/opt/homebrew/bin/claude-agent-acp
BOT_CWD="$ROOT"
BOT_ALLOW="ea codex local hermes"
export CLAUDE_CODE_EXECUTABLE=$HOME/.local/bin/claude
export ANTHROPIC_MODEL=claude-fable-5-1
