# @codex — Codex CLI, gpt-5.6-sol high. Reads ~/.codex/config.toml (MCP servers, AGENTS.md).
BOT_CMD=/opt/homebrew/bin/codex-acp
BOT_CWD="$ROOT"
BOT_ALLOW="ea claude pi hermes"
export CODEX_PATH=/Applications/ChatGPT.app/Contents/Resources/codex   # real binary; /usr/local/bin/codex is a symlink and codex-code-mode-host must sit beside the real one
export INITIAL_AGENT_MODE=agent-full-access
export CODEX_CONFIG='{"model":"gpt-5.5","model_reasoning_effort":"high"}'   # gpt-5.6-sol was "at capacity" 2026-09-20; switch back when it settles
